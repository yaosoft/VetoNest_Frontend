{% block content %}
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Consultation not available — {{ siteName }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f4;font-family:Arial,sans-serif;">
  <table width="100%" cellspacing="0" cellpadding="0" border="0">
    <tr>
      <td align="center" style="padding:40px 10px;">
        <table width="600" cellspacing="0" cellpadding="0" border="0" style="background:#ffffff;border-radius:10px;overflow:hidden;">

          <!-- Header -->
          <tr>
            <td style="background:#27ae60;padding:28px 32px;">
              <h1 style="margin:0;color:#ffffff;font-size:22px;">🐾 {{ siteName }}</h1>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:32px;">
              <p style="margin:0 0 16px;font-size:16px;color:#333;">Hello <strong>{{ ownerName }}</strong>,</p>

              <div style="background:#fff3e0;border-left:4px solid #f57c00;border-radius:6px;padding:16px 20px;margin-bottom:24px;">
                <p style="margin:0;font-size:16px;color:#e65100;font-weight:bold;">⚠️ Your consultation request was not accepted.</p>
              </div>

              <p style="margin:0 0 24px;font-size:15px;color:#555;">
                Unfortunately, Dr <strong>{{ vetName }}</strong> is unable to take your consultation request for <strong>{{ petName }}</strong> on the requested date and time.
              </p>

              <table width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f9f9f9;border-radius:8px;padding:16px;margin-bottom:24px;">
                <tr><td style="padding:6px 0;font-size:14px;color:#555;"><strong>📅 Date:</strong> {{ consultationDate }}</td></tr>
                <tr><td style="padding:6px 0;font-size:14px;color:#555;"><strong>🕐 Time:</strong> {{ consultationTime }}</td></tr>
                <tr><td style="padding:6px 0;font-size:14px;color:#555;"><strong>👨‍⚕️ Vet:</strong> Dr {{ vetName }}</td></tr>
                <tr><td style="padding:6px 0;font-size:14px;color:#555;"><strong>🐾 Pet:</strong> {{ petName }}</td></tr>
              </table>

              <p style="margin:0 0 24px;font-size:14px;color:#555;">
                Don't worry — you can book another consultation with a different vet or choose a new date.
              </p>

              <p style="text-align:center;margin:0 0 32px;">
                <a href="{{ siteURL }}" style="background:#27ae60;color:#fff;padding:12px 28px;border-radius:6px;text-decoration:none;font-size:15px;font-weight:bold;">
                  Book a new consultation →
                </a>
              </p>

              <p style="margin:0;font-size:13px;color:#aaa;">
                The {{ siteName }} Team &nbsp;|&nbsp; <a href="{{ siteURL }}" style="color:#27ae60;">{{ siteDomain }}</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
{% endblock %}
