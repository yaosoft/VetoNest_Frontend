{% block content %}
{% set isFr = siteLocale starts with 'fr' %}
<html lang="{{ isFr ? 'fr' : 'en' }}">
<head>
  <meta charset="UTF-8">
  <title>{{ isFr ? 'Nouvelle demande de consultation' : 'New consultation request' }} — {{ siteName }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f4;font-family:Arial,sans-serif;">
  <table width="100%" cellspacing="0" cellpadding="0" border="0">
    <tr>
      <td align="center" style="padding:40px 10px;">
        <table width="600" cellspacing="0" cellpadding="0" border="0" style="background:#ffffff;border-radius:10px;overflow:hidden;">

          <!-- Header -->
          <tr>
            <td style="background:#27ae60;padding:28px 32px;">
              <img src="http://localhost:3000/img/logo01.png" alt="{{ siteName }}" style="height:48px;display:block;" />
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:32px;">
              <p style="margin:0 0 16px;font-size:16px;color:#333;">
                {{ isFr ? 'Bonjour' : 'Hello' }} <strong>{{ vetName }}</strong>,
              </p>
              <p style="margin:0 0 24px;font-size:15px;color:#555;">
                {% if isFr %}
                  Vous avez reçu une nouvelle demande de consultation de la part de <strong>{{ ownerName }}</strong> pour son animal <strong>{{ petName }}</strong>.
                {% else %}
                  You have received a new consultation request from <strong>{{ ownerName }}</strong> for their pet <strong>{{ petName }}</strong>.
                {% endif %}
              </p>

              <table width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f9f9f9;border-radius:8px;padding:16px;margin-bottom:24px;">
                <tr><td style="padding:6px 0;font-size:14px;color:#555;"><strong>📅 {{ isFr ? 'Date' : 'Date' }} :</strong> {{ consultationDate }}</td></tr>
                <tr><td style="padding:6px 0;font-size:14px;color:#555;"><strong>🕐 {{ isFr ? 'Heure' : 'Time' }} :</strong> {{ consultationTime }}</td></tr>
                <tr><td style="padding:6px 0;font-size:14px;color:#555;"><strong>🐾 {{ isFr ? 'Animal' : 'Pet' }} :</strong> {{ petName }}</td></tr>
                <tr><td style="padding:6px 0;font-size:14px;color:#555;"><strong>👤 {{ isFr ? 'Propriétaire' : 'Owner' }} :</strong> {{ ownerName }}</td></tr>
                {% if complaint %}
                <tr><td style="padding:6px 0;font-size:14px;color:#555;"><strong>📋 {{ isFr ? 'Motif' : 'Complaint' }} :</strong> {{ complaint }}</td></tr>
                {% endif %}
              </table>

              <p style="margin:0 0 24px;font-size:14px;color:#888;">
                {% if isFr %}
                  Connectez-vous à votre compte {{ siteName }} pour accepter ou refuser cette demande.
                {% else %}
                  Please log in to your {{ siteName }} account to accept or refuse this request.
                {% endif %}
              </p>

              <p style="text-align:center;margin:0 0 32px;">
                <a href="{{ siteURL }}/consultation/vet/list" style="background:#27ae60;color:#fff;padding:12px 28px;border-radius:6px;text-decoration:none;font-size:15px;font-weight:bold;">
                  {{ isFr ? 'Voir la demande →' : 'View request →' }}
                </a>
              </p>

              <p style="margin:0;font-size:13px;color:#aaa;">
                {{ isFr ? 'L\'équipe' : 'The' }} {{ siteName }} {{ isFr ? '' : 'Team' }} &nbsp;|&nbsp;
                <a href="{{ siteURL }}" style="color:#27ae60;">{{ siteDomain }}</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
{% endblock %}
