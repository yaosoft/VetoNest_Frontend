# Loaded by `npm run build` (CRA always sets NODE_ENV=production for builds,
# staging included — see package.json's "build:staging" script for how a
# staging build overrides these two with REACT_APP_* env vars on the command
# line, which take precedence over this file).
REACT_APP_API_URL=https://backend.vetonest.com/api/
REACT_APP_BASE_URL=https://backend.vetonest.com/

# Payments are off in production for now (business decision, 2026-09-27) —
# staging build:staging below explicitly keeps this true.
REACT_APP_PAYMENTS_ENABLED=false
